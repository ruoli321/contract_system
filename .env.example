# ═══════════════════════════════════════════
# 合同管理系统 - 环境变量配置模板
# 复制本文件为 .env 后修改敏感值
# ═══════════════════════════════════════════

# ── 端口配置 ──
ODOO_PORT=8069
AI_PORT=8000
# Chroma 向量库端口（注意：不可与 ai-service 的 8000 冲突）
CHROMA_PORT=8001
# PostgreSQL 端口
POSTGRES_PORT=5432

# ── PostgreSQL ──
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# ── Chroma 向量库（独立服务，无需密码即可互访）──
# 容器内：CHROMA_HOST=chroma（服务名），CHROMA_PORT=8000（容器内部端口）
# 本地开发（直接跑 Python）：CHROMA_HOST=localhost，CHROMA_PORT=8001（宿主机映射端口）
CHROMA_HOST=chroma
CHROMA_PORT=8000
# 遥测数据（False = 关闭，True = 发送匿名使用数据）
CHROMA_TELEMETRY=False

# ── LLM 配置（四选一，其他填法请注释掉）──
# 选项A：DeepSeek（推荐，性价比高）
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 选项B：阿里云通义千问
# LLM_PROVIDER=qwen
# LLM_API_KEY=sk-your-qwen-api-key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 选项C：Anthropic Claude
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-your-key
# LLM_BASE_URL=
# LLM_MODEL=claude-3-5-sonnet-latest

# 选项D：OpenAI GPT
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your-openai-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# ── Embedding 模型 ──
# 本地用 bge-large-zh-v1.5（免费、中文效果好），或用在线接口
EMBEDDING_MODEL=bge-large-zh-v1.5
# 若用在线 Embedding API：
# EMBEDDING_API_KEY=your-key
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3

# ── 服务日志 ──
LOG_LEVEL=INFO
