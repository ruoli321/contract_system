.env
.env.local

# ── Docker 卷数据 ──
chroma_data/
odoo_data/
__pycache__/
*.pyc

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo

# ── OS ──
.DS_Store
Thumbs.db

# ── Python ──
*.egg-info/
.venv/
venv/
build/
dist/

# ── Odoo ──
odoo/logs/
